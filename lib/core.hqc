#nomain
namespace Exported {
    #include <IO, std>
}
struct timespec {
    long int tv_sec;
    long int tv_nsec;
}
foreign:
int clock_gettime(int clock_id, timespec *tp);
:foreign
namespace qsuite {
addr_t passes;
addr_t fails;
const char *RESET  = "\033[0m";
const char *RED    = "\033[31m";
const char *GREEN  = "\033[32m";
const char *YELLOW = "\033[33m";
const char *CYAN   = "\033[36m";
enum ColorMode {
    Always;
    Never;
}
ColorMode color_mode;
char *color(char *ansi) {
    return `ternary(color_mode == ColorMode.Always, ansi, "");
}
namespace Values {
    class Value<T> {
        T value;
        Value(T value) {
            this->value = value;
        }
        void toBeTrue() {
            if (this->value) {
                passes++;
                IO::qout("%s%s        PASS%s\n", color(RESET), color(GREEN), color(RESET));
            } else {
                fails++;
                IO::qout("%s%s        FAIL: Expected true%s\n", color(RESET), color(RED), this->value, color(RESET));
            }
        }
        void toBeFalse() {
            if (!(this->value)) {
                passes++;
                IO::qout("%s%s        PASS%s\n", color(RESET), color(GREEN), color(RESET));
            } else {
                fails++;
                IO::qout("%s%s        FAIL: Expected false%s\n", color(RESET), color(RED), this->value, color(RESET));
            }
        }
        void toBe(T other) {
            if (this->value == other) {
                passes++;
                IO::qout("%s%s        PASS%s\n", color(RESET), color(GREEN), color(RESET));
            } else {
                fails++;
                IO::qout("%s%s        FAIL: Expected equality\n", color(RESET), color(RED), other, this->value, color(RESET));
            }
        }
        void toNotBe(T other) {
            if (this->value != other) {
                passes++;
                IO::qout("%s%s        PASS%s\n", color(RESET), color(GREEN), color(RESET));
            } else {
                fails++;
                IO::qout("%s%s        FAIL: Expected inequality%s\n", color(RESET), color(RED), other, this->value, color(RESET));
            }
        }
        void toBeGreaterThan(T other) {
            if (this->value > other) {
                passes++;
                IO::qout("%s%s        PASS%s\n", color(RESET), color(GREEN), color(RESET));
            } else {
                IO::qout("%s%s        FAIL: Expected greater than%s\n", color(RESET), color(RED), other, this->value, color(RESET));
                fails++;
            }
        }
        void toBeLessThan(T other) {
            if (this->value < other) {
                passes++;
                IO::qout("%s%s        PASS%s\n", color(RESET), color(GREEN), color(RESET));
            } else {
                IO::qout("%s%s        FAIL: Expected less than%s\n", color(RESET), color(RED), other, this->value, color(RESET));
                fails++;
            }
        }
        void toBeAtLeast(T other) {
            if (this->value >= other) {
                passes++;
                IO::qout("%s%s        PASS%s\n", color(RESET), color(GREEN), color(RESET));
            } else {
                IO::qout("%s%s        FAIL: Expected at least%s\n", color(RESET), color(RED), other, this->value, color(RESET));
                fails++;
            }
        }
        void toBeAtMost(T other) {
            if (this->value <= other) {
                passes++;
                IO::qout("%s%s        PASS%s\n", color(RESET), color(GREEN), color(RESET));
            } else {
                IO::qout("%s%s        FAIL: Expected at most%s\n", color(RESET), color(RED), other, this->value, color(RESET));
                fails++;
            }
        }
        void toBeAround(T other, double margin_of_error = 0.01) {
            if (this->value >= other - margin_of_error && this->value <= other + margin_of_error) {
                passes++;
                IO::qout("%s%s        PASS%s\n", color(RESET), color(GREEN), color(RESET));
            } else {
                IO::qout("%s%s        FAIL: Expected to be around%s\n", color(RESET), color(RED), other, this->value, color(RESET));
                fails++;
            }
        }
    }
}
namespace Test {
    class Test {
        Test() {
        }
        Values::Value<T> expect<T>(T value, char *message) {
            IO::qout("%s%s    %s%s\n", color(RESET), color(CYAN), message, color(RESET));
            return Values::Value<T>(value);
        }
        void logFail(char *message) {
            IO::qout("%s%s    %s%s\n", color(RESET), color(CYAN), message, color(RESET));
            fails++;
        }
        void logPass(char *message) {
            IO::qout("%s%s    %s%s\n", color(RESET), color(CYAN), message, color(RESET));
            passes++;
        }
    }
}
namespace Suite {
    struct Settings {
        ColorMode color_mode;
        double max_ms;
    }
    class Suite { 
        double max_ms;
        Suite(Settings settings) {
            passes = 0;
            fails = 0;
            color_mode = settings.color_mode;
            this->max_ms = settings.max_ms;
        }
        void operator( )(fn(Test::Test) -> void t, char *descriptor) {
            timespec start = timespec{};
            timespec end = timespec{};
            IO::qout("%s\n", descriptor);
            clock_gettime(1, &start);
            t(Test::Test());
            clock_gettime(1, &end);
            double elapsed_ms = ((end.tv_sec - start.tv_sec) * 1000000000 + (end.tv_nsec - start.tv_nsec)) / 1000000.0;
            IO::qout("%s%sSummary:\n", color(RESET), color(CYAN));
            IO::qout("    %i passed\n", passes);
            IO::qout("    %i failed\n", fails);
            IO::qout("    Elapsed time: %d ms\n", elapsed_ms);
            if (elapsed_ms > this->max_ms) {
                IO::qout("%sWARNING: Elapsed time was %d milliseconds over the maximum.%s\n", color(YELLOW), elapsed_ms - this->max_ms, color(RESET));
            }
            IO::qout("Overall: %s%s\n", `ternary(fails > 0, "FAIL", "PASS"), color(RESET));
        }
    }
}
}
:w
